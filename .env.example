# bulkhaul-server 生产环境变量模板（复制为 .env 并填真实值；.env 已 gitignore，勿提交真实密钥/密码）
# 所有变量均有 dev 默认值（application.yml），生产部署必须覆盖以下敏感项。

# ---- 服务 ----
SERVER_PORT=8081

# ---- 数据库（生产必须覆盖）----
DB_URL=jdbc:mysql://db:3306/blms?useUnicode=true&characterEncoding=utf8&useSSL=true&serverTimezone=Asia/Shanghai
DB_USERNAME=blms
DB_PASSWORD=CHANGE_ME_strong_password

# ---- Redis（生产必须覆盖）----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- JWT（生产必须覆盖；≥32 字节随机密钥，如 openssl rand -base64 48）----
JWT_SECRET=CHANGE_ME_64_char_random_secret
JWT_TTL_MINUTES=480

# ---- 服务端定时任务（C4：生产开启，leader 单实例执行）----
SCHEDULER_AUTO_ENABLED=false

# ---- 全局限流（A3：Redis 固定窗口 60s；登录/验证码按 IP，写端点按用户；超限 429+Retry-After）----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_WRITE_PER_MINUTE=100

# ---- CORS 白名单（C5：默认空=不做 CORS 处理，Nginx 反代同源部署直通；仅前端与后端不同源时填前端域名启用 CORS 强制，逗号分隔，支持通配）----
CORS_ALLOWED_ORIGINS=

# ---- OpenAPI/Swagger（D1：dev 公开联调看文档；生产 false 需认证，不暴露 API 面）----
OPENAPI_PUBLIC=false

# ---- 日志 ----
LOG_LEVEL_COM_BLMS=info
